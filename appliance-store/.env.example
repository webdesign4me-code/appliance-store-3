# Copy this file to .env and fill in your real values. Never commit .env to GitHub.

# Server
PORT=5000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=appliance_store
DB_PORT=3306

# Admin auth
JWT_SECRET=change_this_to_a_long_random_string

# Payment account details shown to customers at checkout.
# Customers send money to these accounts, then enter the transaction ID.
JAZZCASH_NUMBER=03xx-xxxxxxx
JAZZCASH_ACCOUNT_TITLE=Your Name
EASYPAISA_NUMBER=03xx-xxxxxxx
EASYPAISA_ACCOUNT_TITLE=Your Name
BANK_NAME=Your Bank
BANK_ACCOUNT_TITLE=Your Name
BANK_ACCOUNT_NUMBER=xxxxxxxxxxxx
BANK_IBAN=PKxx xxxx xxxx xxxx xxxx xxxx
